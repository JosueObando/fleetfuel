# Configuración del respaldo. Copiar a ~/.config/fleetfuel-respaldo.env
# (fuera del repo: son datos de infraestructura, no de la aplicación).

# Equipo de la red MUPA que recibe la copia. Sin esto, el respaldo se queda en
# el MISMO disco que la base y no protege contra la pérdida del equipo.
REMOTO_DESTINO=respaldos@10.0.0.XX:/srv/respaldos/fleetfuel
REMOTO_LLAVE=/home/app/.ssh/id_ed25519_respaldos

# Retención. 7 diarios + 4 semanales ≈ un mes de profundidad.
RETENCION_DIARIOS=7
RETENCION_SEMANALES=4
