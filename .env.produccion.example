# Configuración de PRODUCCIÓN. Copiar a .env.produccion y rellenar.
#
# .env.produccion está en .gitignore y NO debe versionarse. Los valores de
# aquí son marcadores: si alguno llega a producción tal cual, es un fallo.

APP_NAME=FleetFuel Control
APP_ENV=production

# Puertos en el HOST. Distintos de los de desarrollo (4100/3100) porque los dos
# entornos conviven en esta máquina.
BACKEND_PORT=4200
FRONTEND_PORT=3200

# La base de datos NO se publica: el backend la alcanza por la red interna.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=fleetfuel
DATABASE_USER=fleetfuel_owner
DATABASE_PASSWORD=GENERAR_UNA_LARGA_Y_ALEATORIA

# Rol de aplicación, sujeto a RLS. NUNCA el mismo que el dueño: el dueño de una
# tabla evade sus propias políticas y el aislamiento entre empresas
# desaparecería sin un solo síntoma. El arranque lo verifica y se niega.
DATABASE_APP_USER=fleetfuel_app
DATABASE_APP_PASSWORD=GENERAR_OTRA_DISTINTA

# Secretos de sesión. Generar con: openssl rand -base64 48
JWT_SECRET=GENERAR
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=GENERAR_OTRO_DISTINTO
REFRESH_TOKEN_EXPIRES_IN=7d

REDIS_HOST=redis
REDIS_PORT=6379

MFA_EMISOR=FleetFuel Control
MFA_ROLES_OBLIGATORIOS=Administrador,Supervisor de operaciones

IDEMPOTENCIA_TTL_HORAS=24

# --- Freno de fuerza bruta del login (src/common/throttling/) ---
# Dos frenos a la vez: uno estricto por (IP, cuenta) y uno holgado por IP.
# El estricto ataja la enumeracion de codigos TOTP, que va siempre contra UNA
# cuenta; el holgado atrapa el barrido, que reparte pocos intentos entre
# muchas. Contar solo por IP dejaria fuera a una oficina entera detras de NAT
# en cuanto varias personas se equivoquen de clave a la misma hora.
#
# OJO: el freno cuenta por la IP que resuelve `trust proxy`. Si
# PROXIES_DE_CONFIANZA esta mal, TODAS las peticiones comparten la IP del
# proxy y el limite por IP se convierte en un limite global — el sitio se
# bloquea solo. Van juntos.
LOGIN_VENTANA_SEGUNDOS=60
LOGIN_LIMITE_CUENTA=5
LOGIN_LIMITE_IP=30
LOGIN_BLOQUEO_SEGUNDOS=300


# Proxies inversos de confianza. Sin esto, la auditoria registraria TODOS los
# accesos como provenientes del proxy. Nunca poner "true": permitiria a un
# cliente falsificar su IP con X-Forwarded-For.
PROXIES_DE_CONFIANZA=10.0.0.19

# URL de la API tal como la vera el NAVEGADOR. Es RELATIVA a proposito: el
# proxy sirve el frontend en "/" y la API en "/api" bajo el MISMO origen, asi
# que "/api" se resuelve contra el origen de la pagina, sea cual sea.
#
# Con una URL absoluta (http://10.0.0.193:4200/api) el navegador llamaria a la
# API por su puerto, saltandose el proxy: sin TLS, sin limite de peticiones y
# con la clave y el codigo MFA viajando en claro por la LAN. El proxy quedaria
# sirviendo solo el HTML.
#
# Ademas, al ser del mismo origen el navegador no dispara CORS ni el preflight
# OPTIONS de PATCH/DELETE, y el bundle deja de llevar una IP horneada dentro:
# el mismo build sirve para cualquier dominio futuro.
#
# Se hornea al CONSTRUIR (NEXT_PUBLIC_* se sustituye en compilacion). Cambiarla
# exige reconstruir la imagen del frontend, no basta con reiniciar.
NEXT_PUBLIC_API_URL=/api

# Semilla inicial. Solo se usa la primera vez, con `run --rm migraciones
# npm run seed:dist`. Cambiar la clave tras el primer acceso.
SEED_EMPRESA_NOMBRE=Flota propia
SEED_EMPRESA_RUC=
SEED_ADMIN_CORREO=
SEED_ADMIN_CLAVE=
