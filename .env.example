# ---- App ----
APP_NAME=FleetFuel_Control
APP_ENV=development
BACKEND_PORT=4100

# ---- Base de datos (PostgreSQL 16 + PostGIS 3.4) ----
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=fleetfuel_db

# Dueño del esquema: corre migraciones y seeds. NO lo usa la aplicación.
DATABASE_USER=fleetfuel_owner
DATABASE_PASSWORD=cambiar_en_produccion

# Rol de la aplicación: sujeto a RLS y sin DELETE sobre las tablas críticas
# (§7 «Registros críticos no eliminables»). Lo crea la migración base.
DATABASE_APP_USER=fleetfuel_app
DATABASE_APP_PASSWORD=cambiar_en_produccion_app

# ---- Auth (§7: access 15 min, refresh 7 días revocable) ----
JWT_SECRET=cambiar_este_secreto_en_produccion
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=cambiar_este_secreto_de_refresco
REFRESH_TOKEN_EXPIRES_IN=7d

# ---- Redis (revocación de refresh tokens) ----
REDIS_HOST=localhost
REDIS_PORT=6380

# ---- MFA (§7: TOTP obligatorio para Administrador, Finanzas y Auditor) ----
MFA_EMISOR=FleetFuel Control
# Qué roles exigen TOTP NO se configura aquí: es la columna `roles.exige_mfa`,
# que el seed marca para Administrador, Finanzas y Auditor (§7).

# ---- Idempotencia (ADR 004) ----
IDEMPOTENCIA_TTL_HORAS=24

# --- Freno de fuerza bruta del login (src/common/throttling/) ---
# Dos frenos a la vez: uno estricto por (IP, cuenta) y uno holgado por IP.
# El estricto ataja la enumeracion de codigos TOTP, que va siempre contra UNA
# cuenta; el holgado atrapa el barrido, que reparte pocos intentos entre
# muchas. Contar solo por IP dejaria fuera a una oficina entera detras de NAT
# en cuanto varias personas se equivoquen de clave a la misma hora.
#
# OJO: el freno cuenta por la IP que resuelve `trust proxy`. Si
# PROXIES_DE_CONFIANZA esta mal, TODAS las peticiones comparten la IP del
# proxy y el limite por IP se convierte en un limite global — el sitio se
# bloquea solo. Van juntos.
LOGIN_VENTANA_SEGUNDOS=60
LOGIN_LIMITE_CUENTA=5
LOGIN_LIMITE_IP=30
LOGIN_BLOQUEO_SEGUNDOS=300


# ---- Seed inicial ----
SEED_EMPRESA_NOMBRE=Flota propia
SEED_EMPRESA_RUC=8-NT-1-000
SEED_ADMIN_CORREO=admin@fleetfuel.jop.lat
SEED_ADMIN_CLAVE=Admin12345*

# Proxies inversos de confianza (IP o CIDR, separados por coma). Vacio = sin
# proxy delante. NUNCA poner "true": permitiria a un cliente falsificar su IP
# en la auditoria via X-Forwarded-For.
PROXIES_DE_CONFIANZA=
