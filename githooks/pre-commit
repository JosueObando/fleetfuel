#!/bin/sh
#
# Puerta rápida antes de cada commit: tipos, estilo y pruebas unitarias.
#
# POR QUÉ EXISTE
#
# La lista del skill de TDD pide `<test> && <lint>` en pre-commit, y era la
# única sección que este repositorio nunca había tenido: ni gancho, ni —en el
# backend— ESLint siquiera. CI lo atrapaba todo, pero horas después y con el
# commit ya empujado.
#
# QUÉ NO HACE, Y POR QUÉ
#
# No corre las pruebas de integración ni la cobertura. Necesitan Postgres y
# Redis levantados, y un gancho que falla cuando Docker está parado se
# convierte en `--no-verify` por costumbre en una semana. Eso vive en CI, que
# sí puede garantizar el entorno.
#
# ALCANCE POR CARPETA
#
# Sólo se comprueba lo que el commit toca. Un commit de backend paga ~31 s
# (tipos 4 s, estilo 11 s, unitarias 16 s) y no arrastra al frontend.
#
# Para saltárselo en un caso puntual: `git commit --no-verify`. Que sea una
# decisión visible y por commit, no un interruptor que alguien apaga y olvida.

set -e

raiz=$(git rev-parse --show-toplevel)
tocados=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$tocados" ]; then
  exit 0
fi

puerta() {
  carpeta=$1
  shift
  echo "── $carpeta ──────────────────────────────────────────"
  cd "$raiz/$carpeta"
  for paso in "$@"; do
    npm run --silent "$paso"
  done
}

if echo "$tocados" | grep -q '^backend/'; then
  puerta backend typecheck lint test
fi

# El frontend YA pasa por `lint` (2026-09-12). Estuvo fuera mientras arrastró
# 13 errores propios anteriores a que hubiera gancho; ponerlo antes habría
# bloqueado commits por algo que no rompían, y la salida de eso es
# `--no-verify` por costumbre.
#
# Los 13 se cerraron en el mismo día y sin silenciar nada que fuera cierto:
#
#   · 4 `set-state-in-effect` eran REALES —un `setState` síncrono dentro de un
#     efecto— y se arreglaron derivando el valor en vez de vaciarlo, y leyendo
#     la sesión con `useSyncExternalStore`;
#   · 5 eran falsos positivos —el `setState` va tras un `await`— y el patrón,
#     que estaba copiado cinco veces, vive ahora en `useCargaInicial`;
#   · 3 `no-explicit-any` eran el mismo `type Fila` copiado, hoy en
#     `src/api/tipos.ts` con la excepción declarada UNA vez y explicada;
#   · 1 `require()` en la preparación de las pruebas pasó a `import`.
#
# Entra a la vez que el paso equivalente del trabajo `frontend` de CI: un lint
# que sólo corre en un sitio se erosiona en el otro.
if echo "$tocados" | grep -q '^frontend/'; then
  puerta frontend typecheck lint test
fi

echo "✓ puerta previa al commit superada"
