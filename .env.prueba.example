APP_NAME=FleetFuel Control (prueba)
APP_ENV=prueba
BACKEND_PORT=4300
FRONTEND_PORT=3300

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=fleetfuel_prueba
DATABASE_USER=fleetfuel_owner
DATABASE_PASSWORD=cambiar_por_un_valor_propio
DATABASE_APP_USER=fleetfuel_app
DATABASE_APP_PASSWORD=cambiar_por_un_valor_propio

# Secretos PROPIOS, no los de produccion. Un token emitido en prueba no puede
# valer en produccion: si compartieran secreto, valdria.
JWT_SECRET=cambiar_por_un_valor_propio
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=cambiar_por_un_valor_propio
REFRESH_TOKEN_EXPIRES_IN=7d

REDIS_HOST=redis
REDIS_PORT=6379

MFA_EMISOR=FleetFuel Control (prueba)
IDEMPOTENCIA_TTL_HORAS=24

LOGIN_VENTANA_SEGUNDOS=60
LOGIN_LIMITE_CUENTA=5
LOGIN_LIMITE_IP=30
LOGIN_BLOQUEO_SEGUNDOS=300

# VACIO a proposito: aqui no hay proxy delante, asi que la IP del socket ES la
# del cliente. Poner 10.0.0.19 haria que el backend creyera un X-Forwarded-For
# que nadie pone, y cualquiera podria falsificar su IP en el registro.
PROXIES_DE_CONFIANZA=

# Absoluta, no relativa: sin proxy no hay origen unico. Ver la cabecera del
# docker-compose.prueba.yml.
NEXT_PUBLIC_API_URL=http://10.0.0.193:4300/api

SEED_EMPRESA_NOMBRE=Flota propia (prueba)
SEED_EMPRESA_RUC=8-NT-1-000
SEED_ADMIN_CORREO=admin@fleetfuel.jop.lat
SEED_ADMIN_CLAVE=cambiar_por_un_valor_propio
