# Copiar a .env.observabilidad y poner una clave propia:
#   cp .env.observabilidad.example .env.observabilidad
#   python3 -c "import secrets,string; a=string.ascii_letters+string.digits; \
#     print(''.join(secrets.choice(a) for _ in range(28)))"
#
# Grafana queda publicado SOLO en la LAN (puerto 3400), no pasa por el proxy
# inverso y no está en internet. Aun así lleva clave: por ella se ven todos los
# registros del sistema, con correos e IPs dentro.
GRAFANA_USUARIO=admin
GRAFANA_CLAVE=cambiar_esta_clave
GRAFANA_PUERTO=3400
